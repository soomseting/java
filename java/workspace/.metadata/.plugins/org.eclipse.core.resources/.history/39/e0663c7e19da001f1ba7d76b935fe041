package quiz21;

public class Data<E> {
//	private
	private String name;
	private int age;
	private String email;
	private String adress;
	
	Data(String name, int age, String email, String adress){
		this.name = name;
		this.age = age;
		this.email = email;
		this.adress  = adress;
	}

	public String getName() {
		return name;
	}

	public void setName(String name) {
		this.name = name;
	}

	public int getAge() {
		return age;
	}

	public void setAge(int age) {
		this.age = age;
	}

	public String getEmail() {
		return email;
	}

	public void setEmail(String email) {
		this.email = email;
	}

	public String getAdress() {
		return adress;
	}

	public void setAdress(String adress) {
		this.adress = adress;
	}
	
}
