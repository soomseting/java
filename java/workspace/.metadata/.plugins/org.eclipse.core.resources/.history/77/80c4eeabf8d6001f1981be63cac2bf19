package quiz17;

import java.util.Arrays;

public class StringQuiz02 {
	public static void main(String[] args) {
		/*
		 * 문자열 거꾸로 뒤집기
		 * 
		 * 매개변수로 전달받은 문자열을, 거꾸로 뒤집어서 반환하는 메서드를 생성하세요.
		 * 
		 * reverse(String)
		 * 입력 -> abcde
		 * 반환 -> edcba
		 */
		
		StringQuiz02 stq2 = new StringQuiz02();
		stq2.reverse("abcde");
		System.out.println(Arrays.toString(stq2));
	}
	
	
	public String reverse(String str) {
		String str2 = "";
		for(int i= 0; i<str.length(); i++) {
			str2 += str.charAt(i);
		}
		return str2;
	}
}
