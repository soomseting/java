package collection.set;

import java.util.*;

public class HashSetEx {
	public static void main(String[] args) {
//		HashSet<String> set = new HashSet<>();
		Set<String> set = new HashSet<>(); // Set type 인터페이스에 HashSet을 저장함

		//값의 추가
		set.add("java");
		set.add("database");
		set.add("git");
		set.add("css");
		set.add("java");
		set.add("java");

		System.out.println("Set 크기 : " + set.size());
		System.out.println(set.toString());
		
		//값의 삭제
		set.remove("java");
		System.out.println(set.toString());
		
		//값의 조회 - get 메서드가 없고, 반복자(iterator)를 통해서 하나씩 꺼내봐야 합니다.
		
		//반복자로 변경
		Iterator<String> iter = set.iterator();
		
		//다음이 있는지 확인하고 반복
		while(iter.hasNext()) {
			System.out.println(iter.next());
		}
		
	}
}
