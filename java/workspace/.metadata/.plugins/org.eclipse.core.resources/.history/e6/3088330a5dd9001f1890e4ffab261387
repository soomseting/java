package quiz21;

import java.util.*;
import java.io.*;

public class FileQuiz01 {
	public static void main(String[] args) {
		/*
		 * 1. Scanner를 이용해서 File명을 입력 받습니다.
		 * 2. file폴더 하위에 입력받은 파일명으로 파일을 씁니다. 
		 * 3. 파일을 쓸 때, "쓰고 싶은 말"을 사용자에게 입력 받습니다.
		 */
		FileOutputStream fos = null;
		Scanner sc = new Scanner(System.in);
		System.out.println("파일명을 입력해 주세요");
		String name = sc.next();
		String path = "C:\\Users\\user\\Desktop\\course\\java\\file";
		path += "\\" + name+".txt";
		
		try {
			fos = new FileOutputStream(path);

			System.out.println("파일에 쓰고 싶은 말을 입력해 주세요");
			String txt = sc.next();
			
			fos.write(txt.getBytes());
		} catch (Exception e) {
			e.printStackTrace();
		}finally {
			try {
				fos.close();
			} catch (Exception e2) {
				// TODO: handle exception
			}
		}

	}
}
